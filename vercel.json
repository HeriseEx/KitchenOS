{
  "version": 2,
  "builds": [
    {
      "src": "build/web/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/index.html",
      "headers": {
        "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload"
      }
    }
  ]
}
